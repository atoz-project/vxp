#!/usr/bin/env -S uv run -q --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["pyyaml>=6"]
# ///
"""条目记录检查器：调用 entry_record.collect 与 entry_rules.check。

接口：
    catalog = collect(Path("/path/to/repo"))
    findings = check(catalog)
    not findings  # => 所有条目满足约定

CLI：
    uv run bin/check-entries [--root DIR]

退出码：0 无问题，1 有问题，2 用法错误。
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

from entry_record import collect
from entry_rules import check


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="check-entries", description="检查 VXP 条目记录")
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parent.parent, help="仓库根目录")
    args = parser.parse_args(argv)

    catalog = collect(args.root)
    findings = sorted(
        [*catalog.findings, *check(catalog)],
        key=lambda finding: (finding.path, finding.rule, finding.message),
    )
    if not findings:
        print(f"检查 {len(catalog.records)} 个条目：0 条问题")
        return 0

    for finding in findings:
        print(f"✗ {finding}")
    print(f"检查 {len(catalog.records)} 个条目：{len(findings)} 条问题")
    return 1


if __name__ == "__main__":
    sys.exit(main())