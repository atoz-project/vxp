#!/usr/bin/env -S uv run -q --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["pyyaml>=6"]
# ///
"""条目记录检查器入口：把仓库根目录放上 sys.path，调用 vxp_check.cli.main。

uv 运行脚本时把 bin/ 放进 sys.path，而 vxp_check 包在仓库根目录；这一行是唯一的路径声明。

CLI：
    uv run bin/check-entries [--root DIR]

退出码：0 无问题，1 有问题，2 用法错误。
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from vxp_check.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())